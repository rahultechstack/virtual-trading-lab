# ---------------------------------------------------------------------------
# Infrastructure environment (consumed by docker-compose.yml)
# Copy to .env before running: cp .env.example .env
# ---------------------------------------------------------------------------

# --- Instrument shown in the UI (must match TRADING_SYMBOL in backend/.env) ---
TRADING_SYMBOL=RELIANCE
TRADING_EXCHANGE=NSE

POSTGRES_USER=vtrader
POSTGRES_PASSWORD=vtrader_dev_password
POSTGRES_DB=virtual_trading
POSTGRES_HOST_PORT=5432

# --- Host port mappings ---
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
