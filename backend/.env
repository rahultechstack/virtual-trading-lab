# ---------------------------------------------------------------------------
# Backend environment. Copy to .env before running:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Virtual Trading Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database (must match docker-compose.yml / root .env) ---
POSTGRES_USER=vtrader
POSTGRES_PASSWORD=vtrader_dev_password
POSTGRES_DB=virtual_trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Domain constants (single instrument, single wallet by design) ---
TRADING_SYMBOL=RELIANCE
TRADING_EXCHANGE=NSE

# --- Wallet ---
# Opening capital for the single virtual account (INR 10,00,000).
WALLET_INITIAL_BALANCE=1000000.00
WALLET_CURRENCY=INR

# --- Market data ---
# Provider implementation to load. Available: yahoo
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_TIMEOUT_SECONDS=15

# Credentials for providers that require them. The default (yahoo) needs none.
# NEVER commit real keys - this file is the example, .env is gitignored.
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=

# --- Execution realism ---
# Charge schedule: INTRADAY or DELIVERY
EXECUTION_SEGMENT=INTRADAY

# Bid/ask spread in basis points (FULL spread; half applied each side)
SPREAD_BPS=2

# Slippage model: NONE, FIXED_BPS or PERCENT. Always adverse.
SLIPPAGE_MODEL=FIXED_BPS
SLIPPAGE_BPS=2
SLIPPAGE_PERCENT=0

# --- Charges (percentages of turnover; 0.03 means 0.03%) ---
# Master switch - set false for frictionless simulation.
CHARGES_ENABLED=true

BROKERAGE_PERCENT=0.03
BROKERAGE_MAX_PER_ORDER=20

STT_INTRADAY_SELL_PERCENT=0.025
STT_DELIVERY_PERCENT=0.1

EXCHANGE_TXN_PERCENT=0.00297
SEBI_CHARGES_PERCENT=0.0001

STAMP_DUTY_INTRADAY_BUY_PERCENT=0.003
STAMP_DUTY_DELIVERY_BUY_PERCENT=0.015

GST_PERCENT=18
DP_CHARGES_PER_SELL=0

# --- Real-time streaming ---
STREAM_POLL_INTERVAL_SECONDS=5
STREAM_MAX_CONNECTIONS=50
STREAM_MODEL_BID_ASK=true

# --- Mock provider (set MARKET_DATA_PROVIDER=mock to use it) ---
# SIMULATED DATA. Development only - never point production at this.
MOCK_BASE_PRICE=1400
MOCK_VOLATILITY_BPS=15
MOCK_SPREAD_BPS=4
MOCK_TICK_INTERVAL_SECONDS=2
# MOCK_SEED=42

# --- Portfolio snapshots ---
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL_SECONDS=300
SNAPSHOT_ON_TRADE=true
SNAPSHOT_SKIP_UNCHANGED=true
