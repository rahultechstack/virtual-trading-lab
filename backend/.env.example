# ---------------------------------------------------------------------------
# Backend environment. Copy to .env before running:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Virtual Trading Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database (must match docker-compose.yml / root .env) ---
POSTGRES_USER=vtrader
POSTGRES_PASSWORD=vtrader_dev_password
POSTGRES_DB=virtual_trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Domain constants (single instrument, single wallet by design) ---
TRADING_SYMBOL=RELIANCE
TRADING_EXCHANGE=NSE
