# ---------------------------------------------------------------------------
# Backend environment. Copy to .env before running:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application ---
# APP_VERSION=0.1.0
APP_NAME="Virtual Trading Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database (must match docker-compose.yml / root .env) ---
POSTGRES_USER=vtrader
POSTGRES_PASSWORD=vtrader_dev_password
POSTGRES_DB=virtual_trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection pooling. Defaults suit a single-user lab; raise the pool for a
# busier deployment.
# DB_ECHO=false                 # log every SQL statement (very noisy)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_PRE_PING=true         # check a pooled connection before using it
# DB_USE_NULL_POOL=false        # no pooling at all; required under pytest

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
#  THE INSTRUMENT THIS PLATFORM TRADES  <-- CHANGE THE SHARE HERE
# ============================================================================
# Single instrument, single wallet by design. Every quote, candle, order,
# position and snapshot in the backend is derived from these two values --
# nothing else needs editing to trade a different share.
#
# TRADING_SYMBOL    the ticker as the exchange lists it (RELIANCE, TCS, INFY)
# TRADING_EXCHANGE  NSE or BSE  (mapped to a Yahoo suffix: NSE -> .NS, BSE -> .BO
#                   in app/market_data/yahoo.py:_EXCHANGE_SUFFIX)
#
# After changing these:
#   1. set VITE_TRADING_SYMBOL / VITE_TRADING_EXCHANGE in frontend/.env to match
#   2. docker compose up -d --force-recreate backend frontend
#      (`docker compose restart` does NOT re-read env_file)
#   3. square off any open position FIRST -- `positions` is keyed by symbol,
#      so an old position row survives the switch and keeps its own P&L.
#   4. if using the mock provider, set MOCK_BASE_PRICE near the new share's price.
TRADING_SYMBOL=RELIANCE
TRADING_EXCHANGE=NSE

# --- Wallet ---
# Opening capital for the single virtual account (INR 10,00,000).
WALLET_INITIAL_BALANCE=1000000.00
WALLET_CURRENCY=INR

# --- Market data ---
# Provider implementation to load. Available: yahoo
MARKET_DATA_PROVIDER=yahoo

# Upstream endpoint the bundled Yahoo-backed providers call. Point this at a
# mirror or a recording proxy without touching any code.
MARKET_DATA_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart
# Yahoo rejects requests without a browser-like agent.
MARKET_DATA_USER_AGENT=Mozilla/5.0 (compatible; VirtualTradingPlatform/0.1)
MARKET_DATA_TIMEOUT_SECONDS=15

# Credentials for providers that require them. The default (yahoo) needs none.
# NEVER commit real keys - this file is the example, .env is gitignored.
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=

# --- Execution realism ---
# Charge schedule: INTRADAY or DELIVERY
EXECUTION_SEGMENT=INTRADAY

# Bid/ask spread in basis points (FULL spread; half applied each side)
SPREAD_BPS=2

# Slippage model: NONE, FIXED_BPS or PERCENT. Always adverse.
SLIPPAGE_MODEL=FIXED_BPS
SLIPPAGE_BPS=2
SLIPPAGE_PERCENT=0

# --- Charges (percentages of turnover; 0.03 means 0.03%) ---
# Master switch - set false for frictionless simulation.
CHARGES_ENABLED=true

BROKERAGE_PERCENT=0.03
BROKERAGE_MAX_PER_ORDER=20

STT_INTRADAY_SELL_PERCENT=0.025
STT_DELIVERY_PERCENT=0.1

EXCHANGE_TXN_PERCENT=0.00297
SEBI_CHARGES_PERCENT=0.0001

STAMP_DUTY_INTRADAY_BUY_PERCENT=0.003
STAMP_DUTY_DELIVERY_BUY_PERCENT=0.015

GST_PERCENT=18
DP_CHARGES_PER_SELL=0

# --- Real-time streaming ---
STREAM_POLL_INTERVAL_SECONDS=5
STREAM_MAX_CONNECTIONS=50
STREAM_MODEL_BID_ASK=true

# --- Mock provider (set MARKET_DATA_PROVIDER=mock to use it) ---
# SIMULATED DATA. Development only - never point production at this.
MOCK_BASE_PRICE=1400
MOCK_VOLATILITY_BPS=15
MOCK_SPREAD_BPS=4
MOCK_TICK_INTERVAL_SECONDS=2
# MOCK_SEED=42

# --- Portfolio snapshots ---
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL_SECONDS=300
SNAPSHOT_ON_TRADE=true
SNAPSHOT_SKIP_UNCHANGED=true
# --- Asset classes: crypto -------------------------------------------------
# Providers are chosen PER ASSET CLASS. The equity feed above serves NSE
# stocks; this one serves cryptocurrencies. Verified to serve BTC-INR /
# ETH-INR with 1m-1mo OHLCV, 24/7.
CRYPTO_MARKET_DATA_PROVIDER=yahoo_crypto
# Crypto pairs are quoted against this currency, so the whole portfolio stays
# in one currency and no FX rate is ever needed.
CRYPTO_QUOTE_CURRENCY=INR

# --- Market hours ----------------------------------------------------------
# Whether the engine REFUSES an order while the instrument's market is closed.
# Off by default: this is a paper-trading lab. Crypto is unaffected either way.
ENFORCE_MARKET_HOURS=false

NSE_TIMEZONE=Asia/Kolkata
NSE_PRE_OPEN_TIME=09:00
NSE_OPEN_TIME=09:15
NSE_CLOSE_TIME=15:30

# NSE trading holidays, ISO dates, comma separated.
# ONLY fixed-date national holidays ship as defaults. Most of India's exchange
# holiday list moves year to year (Diwali, Holi, Eid, Muhurat trading) and
# CANNOT be derived - set this from the official NSE circular each year.
NSE_HOLIDAYS=2026-01-26,2026-05-01,2026-08-15,2026-10-02,2026-12-25

# --- Crypto charges (SIMULATED) --------------------------------------------
# No crypto exchange has been integrated, so these are configurable
# ASSUMPTIONS, not any venue's published schedule. NSE's statutory charges
# (STT, stamp duty, SEBI fee, DP charges) are NEVER applied to crypto.
CRYPTO_FEE_PERCENT=0.10
CRYPTO_GST_PERCENT=18
# TDS on a Virtual Digital Asset transfer (India, s.194S), sell side only.
# Statutory rather than assumed. Set to 0 to disable.
CRYPTO_TDS_PERCENT=1

# --- Automation ------------------------------------------------------------
# Keep polling an instrument with an ACTIVE automatic order even when no
# browser is connected, so a crypto stop-loss set on Friday can fire over the
# weekend. With nothing armed and nobody watching, nothing is polled.
STREAM_POLL_FOR_AUTOMATION=true

# --- Limits ----------------------------------------------------------------
# Bounds enforced on requests. Every validation path reads these, so changing
# one here changes it everywhere.

# Largest quantity a single order may be for, in the instrument's own units.
# Lowering this works immediately. RAISING it above the database CHECK
# constraint (DB_MAX_ORDER_QUANTITY in app/models/trading.py) needs a
# migration.
MAX_ORDER_QUANTITY=10000000

# Most candles any one market-data or backtest request may return.
MAX_CANDLES_PER_REQUEST=5000
# Most rows a history listing (orders, trades, triggers) may return.
MAX_HISTORY_PAGE_SIZE=500
# Default page size when a listing request omits one.
DEFAULT_HISTORY_PAGE_SIZE=100
# Most portfolio snapshots one history request may return. Higher than a normal
# page because the equity curve is plotted from it.
MAX_SNAPSHOT_PAGE_SIZE=5000

# --- Indicators ------------------------------------------------------------
# Most indicators one request may ask for. Each is a full pass over the series.
MAX_INDICATORS_PER_REQUEST=10
# Timezone that anchors intraday VWAP to a trading session.
VWAP_SESSION_TIMEZONE=Asia/Kolkata

# --- Internals -------------------------------------------------------------
# How often the automatic-order monitor re-reads which symbols are armed,
# measured in evaluations. Creating or cancelling an order through the API
# invalidates the cache immediately; this only catches out-of-process inserts.
AUTOMATION_REVALIDATE_EVERY_EVALUATIONS=20
# How far ahead a market calendar searches for the next open or close.
CALENDAR_SEARCH_HORIZON_DAYS=30

# --- Rarely changed --------------------------------------------------------
# Listed so this file is a complete map of what can be tuned. Commented out
# because the defaults are almost always right.

# Version string reported by /health and the OpenAPI document.
# APP_VERSION=0.1.0

# Cap on the crypto exchange fee per order. Blank means no cap.
# CRYPTO_FEE_MAX_PER_ORDER=

# Fixed seed for the mock provider, so simulated prices repeat exactly.
# Leave unset for a different random walk each run.
# MOCK_SEED=42
