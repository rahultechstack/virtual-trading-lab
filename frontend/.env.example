# ---------------------------------------------------------------------------
# Frontend environment. Copy to .env before running:  cp .env.example .env
# Only VITE_-prefixed variables are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# --- Instrument -------------------------------------------------------------
# The share this UI labels itself with. MUST match TRADING_SYMBOL /
# TRADING_EXCHANGE in backend/.env. See frontend/src/config/instrument.ts.
VITE_TRADING_SYMBOL=RELIANCE
VITE_TRADING_EXCHANGE=NSE

VITE_API_BASE_URL=http://localhost:8000
VITE_API_V1_PREFIX=/api/v1

# WebSocket base. Leave blank to derive it from VITE_API_BASE_URL.
VITE_WS_BASE_URL=
