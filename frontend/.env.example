# ---------------------------------------------------------------------------
# Frontend environment. Copy to .env before running:  cp .env.example .env
#
# Only VITE_-prefixed variables reach the browser bundle. Vite inlines them at
# BUILD time, so a production image must be REBUILT after a change here --
# restarting it is not enough.
#
# Everything else the UI can be tuned by lives in frontend/src/config/.
# See CONFIGURATION.md at the repository root.
# ---------------------------------------------------------------------------

# --- Backend connection -----------------------------------------------------
# Read by frontend/src/config/api.ts.

# Origin the backend is served from. No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Path prefix every versioned endpoint sits under. Must match the backend's
# API_V1_PREFIX.
VITE_API_V1_PREFIX=/api/v1

# WebSocket origin. Leave BLANK to derive it from VITE_API_BASE_URL by swapping
# the scheme (http -> ws, https -> wss), which is right in almost every setup.
# Set it only when the socket is served from somewhere else entirely.
VITE_WS_BASE_URL=

# --- Default instrument -----------------------------------------------------
# Read by frontend/src/config/instrument.ts.
#
# Only the placeholder shown before the first tick arrives, and the browser tab
# title. The backend is the authority -- every quote, order and position it
# returns carries its own symbol, and the UI displays that. A mismatch with
# backend/.env is cosmetic, not functional.
VITE_TRADING_SYMBOL=RELIANCE
VITE_TRADING_EXCHANGE=NSE
